# ========================================================
# Slidescoiety Sim Racing Store — Backend Environment Config
# ========================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Client Application URL (Allowed CORS Origin)
CORS_ORIGIN=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# PostgreSQL Connection String (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slidescoiety_db?schema=public"

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# Transactional Email Service (Optional for Development / Testing)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=api_key_or_smtp_user
EMAIL_PASS=api_key_or_smtp_password
EMAIL_FROM="Slidescoiety Sim Racing Store <support@slidescoiety.com>"

# Razorpay Payment Gateway (Test Mode / Production Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Logging Level (combined, dev, tiny)
LOG_FORMAT=dev
