# ========================================================
# Slidescoiety Sim Racing Store — Backend Environment Config
# ========================================================

# Server Runtime Mode & Port
# Set to 'production' for live deployments, 'development' for local work
NODE_ENV=development
PORT=5000

# Client Application URL (Allowed CORS Origin)
CORS_ORIGIN=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# PostgreSQL Connection String (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slidescoiety_db?schema=public"

# Authentication & Session Security
# Generate secure 64-char hex strings in shell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# Transactional Email Service (SMTP)
# Development falls back to console logging; production requires authenticated SMTP.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASSWORD=your_smtp_api_key_or_password
EMAIL_FROM="Slidescoiety Sim Racing Store <support@slidescoiety.com>"
ADMIN_NOTIFICATION_EMAIL=orders@slidescoiety.com

# Seller Legal & Business Information (Printed on Tax Invoices)
SELLER_NAME="Slidescoiety Sim Racing Store"
SELLER_ADDRESS="Plot 42, Racing Tech Park, Bengaluru, Karnataka, India"
SELLER_GSTIN="29AAAAA0000A1Z5"
SELLER_EMAIL=support@slidescoiety.com
SELLER_PHONE="+91 98765 43210"

# Razorpay Payment Gateway (Test Mode / Production Credentials)
# Test Mode: Starts with rzp_test_...
# Live Mode: Starts with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Inventory Reservation Settings
# Minutes before unpaid checkout reservations expire and return to available stock
RESERVATION_EXPIRY_MINUTES=30
RESERVATION_CLEANUP_INTERVAL_MS=300000

# Private Invoice Storage Directory (Path for generated PDF invoices)
# Invoices are served via authenticated streaming API and never exposed statically
# INVOICE_STORAGE_DIR=/var/data/slidescoiety/invoices

# HTTP Request Logging Level (combined, dev, tiny)
LOG_FORMAT=dev
